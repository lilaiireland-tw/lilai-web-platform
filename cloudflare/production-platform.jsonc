{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lilai-web-platform-production",
  "account_id": "622900d9297cd7c09cad966aaae64617",
  "main": "production-platform-worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "../.open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    "SITE_DEPLOYMENT_ENV": "production",
    "EVENT_DEPLOYMENT_ENV": "production",
    "EVENTS_INCLUDE_DRAFTS": "false",
    "NEXT_PUBLIC_SITE_URL": "https://lilaiireland.com"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
