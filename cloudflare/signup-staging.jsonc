{
  "name": "site-creator-vinext-starter-staging",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lilai-applications-staging",
      "database_id": "370f3f4a-a1dd-40d7-8e2d-097fe835747f",
      "migrations_dir": "../migrations/signup"
    }
  ],
  "queues": {
    "producers": [],
    "consumers": []
  },
  "triggers": {
    "crons": []
  },
  "ratelimits": [
    {
      "name": "APPLICATION_RATE_LIMITER",
      "namespace_id": "76082802",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET"
    ]
  },
  "vars": {
    "EMAIL_REPLY_TO": "lilaiireland@gmail.com",
    "INTERNAL_NOTIFICATION_EMAIL": "lilaiireland@gmail.com",
    "NOTION_VERSION": "2022-06-28",
    "NEXT_PUBLIC_NOINDEX": "true",
    "SITE_DEPLOYMENT_ENV": "staging",
    "TURNSTILE_HOSTNAMES": "lilai-web-platform-staging.lilaiireland.workers.dev"
  },
  "routes": [],
  "workers_dev": false,
  "preview_urls": false,
  "main": "../worker/signup/staging.ts",
  "services": [
    {
      "binding": "PLATFORM",
      "service": "lilai-web-platform-staging"
    }
  ],
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "622900d9297cd7c09cad966aaae64617",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
