{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lilai-web-platform-router",
  "account_id": "622900d9297cd7c09cad966aaae64617",
  "main": "production-router-worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "PLATFORM",
      "service": "lilai-web-platform-production"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
