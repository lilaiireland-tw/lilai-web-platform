# Build-time event policy: staging/preview must keep preview.
# Set production only on the existing production build.
EVENT_DEPLOYMENT_ENV=preview
# Optional draft routes in preview builds only (never listed in /events).
EVENTS_INCLUDE_DRAFTS=false
