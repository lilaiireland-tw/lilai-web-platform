NEXT_PUBLIC_SITE_URL=https://lilaiireland.com
# Build-time site policy; unset/preview/staging are all noindex.
# Set production only for a separately approved production build.
SITE_DEPLOYMENT_ENV=preview
# Placeholder only: cms.lilaiireland.com is not currently configured. Do not use
# these values for production until a WordPress.com-supported origin hostname,
# DNS, TLS and Host/SNI behavior have been verified.
WORDPRESS_ORIGIN=https://cms.lilaiireland.com
WORDPRESS_API_BASE=https://cms.lilaiireland.com/wp-json/wp/v2
WOOCOMMERCE_STORE_API_BASE=https://cms.lilaiireland.com/wp-json/wc/store/v1
REVALIDATE_SECRET=change-me

# Build-time event policy: staging/preview must keep preview.
# Set production only on the existing production build.
EVENT_DEPLOYMENT_ENV=preview
# Build fails if only one site/event marker is production.
# Cloudflare staging requires explicit nonproduction origins, not the defaults
# above. See docs/cloudflare-staging.md; no production domain is attached.
# Optional draft routes in preview builds only (never listed in /events).
EVENTS_INCLUDE_DRAFTS=false
